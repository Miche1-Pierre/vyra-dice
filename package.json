    "lucide-react": "^1.52.0",
    "maath": "^0.10.8",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.438.2",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
