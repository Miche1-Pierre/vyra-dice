# Copier en .env.local — ne jamais commiter de vraies valeurs.

# Analytics (PostHog EU)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Données (Supabase, région EU) — G1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Envoi des demandes (docs/notifications.md). Un canal sans tous ses réglages reste éteint ;
# sans aucun canal, une démo accuse réception sans rien envoyer.
# E-mails (Resend) : clé d'API, adresse d'envoi sur le domaine vérifié.
RESEND_API_KEY=
REQUESTS_FROM_EMAIL=
# Qui reçoit les demandes des clubs de démo : l'équipe, jamais le club (adresses séparées par des virgules).
REQUESTS_TEAM_EMAIL=
# WhatsApp (API Cloud de Meta) : jeton, identifiant du numéro d'envoi, numéros de l'équipe (+33 6…).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
REQUESTS_TEAM_WHATSAPP=
# Facultatifs : modèle de message validé par Meta, sa langue, version de l'API.
WHATSAPP_TEMPLATE=nouvelle_demande_table
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_API_VERSION=v23.0
