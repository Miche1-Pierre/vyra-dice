# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 3D references: photos are third-party (no reuse licence) — keep them local only
/art/ref/*/photos/
# Blender autosaves / bake scratch
*.blend1
/art/.bake/
# Generated 3D intermediates (rebuild with art/scripts — see docs/3d-pipeline.md)
/art/blender/*.blend
/art/textures/generated/
/art/export/*.glb
/art/export/*.lightmaps.json
/art/export/*/

# Python bytecode from the Blender scripts
__pycache__/
