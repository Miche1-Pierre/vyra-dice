# Uploaded by `vercel deploy`: the web app only.
# The web reads each club's definition (clubs/<slug>/*.json, index.ts) and its bundle
# (clubs/<slug>/public, published by scripts/sync-club-assets.mjs at build time).
# Blender sources, bakes, references and third-party photos never leave the machine.
art/
clubs/*/blender/
clubs/*/build/
clubs/*/reference/
clubs/*/private/
docs/
.github/
scripts/optimize-glb.mjs
*.blend
*.blend1
